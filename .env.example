# Copy to .env for local development.
# Superuser connection: runs migrations only.
DATABASE_ADMIN_URL=postgres://crm_owner:crm_owner@localhost:5432/crm
# Application connection: least-privilege role, subject to row-level security (step 2).
DATABASE_URL=postgres://crm_app:crm_app@localhost:5432/crm
PORT=3000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET=replace-with-at-least-32-random-characters
# Development only. Refused when NODE_ENV=production.
ALLOW_LOCAL_LOGIN=true
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Set when the API runs behind a reverse proxy, so client addresses are read correctly.
TRUST_PROXY=false
# Each identity provider's client secret lives in the variable its client_secret_env names, e.g.:
# ACME_ENTRA_SECRET=...
